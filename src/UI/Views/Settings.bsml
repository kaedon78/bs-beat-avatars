<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">

  <!--
    No title here. The flow coordinator already sets one, and BSML would draw a second copy of
    the mod name directly beneath it. The container reclaims the height that reserved.
  -->
  <settings-container size-delta-x="-20" anchored-position-x="4">

    <horizontal spacing="1">
      <slider-setting text="Hand size" value="handScale" min="0.3" max="1.5" increment="0.05"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="How big your hands look. 1.0 is the game's own size." />
      <button text="undo" on-click="RevertHandScale" pref-width="14" interactable="~canUndoHandScale"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Head size" value="headScale" min="0.3" max="1.5" increment="0.05"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="How big your head looks. Only the mirror and other cameras see it." />
      <button text="undo" on-click="RevertHeadScale" pref-width="14" interactable="~canUndoHeadScale"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Body size" value="bodyScale" min="0.3" max="1.5" increment="0.05"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="How big your torso looks." />
      <button text="undo" on-click="RevertBodyScale" pref-width="14" interactable="~canUndoBodyScale"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Head height" value="headVerticalOffset" min="-0.3" max="0.3" increment="0.005"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Raises or lowers your head. Your body stays put." />
      <button text="undo" on-click="RevertHeadVerticalOffset" pref-width="14" interactable="~canUndoHeadVerticalOffset"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Body height" value="bodyVerticalOffset" min="-0.3" max="0.3" increment="0.005"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Raises or lowers your torso." />
      <button text="undo" on-click="RevertBodyVerticalOffset" pref-width="14" interactable="~canUndoBodyVerticalOffset"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Grip position" value="handOffsetZ" min="-0.2" max="0.2" increment="0.005"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Slides your hands along the controller to where you hold it." />
      <button text="undo" on-click="RevertHandOffsetZ" pref-width="14" interactable="~canUndoHandOffsetZ"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Hand height" value="handOffsetY" min="-0.2" max="0.2" increment="0.005"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Nudges your hands up or down." />
      <button text="undo" on-click="RevertHandOffsetY" pref-width="14" interactable="~canUndoHandOffsetY"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Hand sideways" value="handOffsetX" min="-0.2" max="0.2" increment="0.005"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Nudges your hands left or right." />
      <button text="undo" on-click="RevertHandOffsetX" pref-width="14" interactable="~canUndoHandOffsetX"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Hand tilt" value="handRotationX" min="-90" max="90" increment="1"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Tilts your hands forward or back, like your wrist angle." />
      <button text="undo" on-click="RevertHandRotationX" pref-width="14" interactable="~canUndoHandRotationX"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Hand turn" value="handRotationY" min="-90" max="90" increment="1"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Turns your hands left or right." />
      <button text="undo" on-click="RevertHandRotationY" pref-width="14" interactable="~canUndoHandRotationY"
              hover-hint="Undo this change." />
    </horizontal>

    <horizontal spacing="1">
      <slider-setting text="Hand twist" value="handRotationZ" min="-90" max="90" increment="1"
                      bind-value="true" apply-on-change="true" pref-width="76"
                      hover-hint="Twists your hands around the controller handle." />
      <button text="undo" on-click="RevertHandRotationZ" pref-width="14" interactable="~canUndoHandRotationZ"
              hover-hint="Undo this change." />
    </horizontal>

    <checkbox-setting text="Match my grip" value="useControllerOffsets"
                      bind-value="true" apply-on-change="true"
                      hover-hint="Line the hands up with the saber grip from your controller settings." />

    <horizontal spacing="2" pad-top="2">
      <button text="Undo all" on-click="RevertAllPressed" interactable="~canUndoAny"
              hover-hint="Undo every change since you opened this panel." />
      <button text="Defaults" on-click="ResetPressed"
              hover-hint="Start over from the settings the mod ships with." />
      <button text="Save" on-click="SavePressed"
              hover-hint="Save now. Also saved automatically when you close this panel." />
    </horizontal>

  </settings-container>

</bg>
