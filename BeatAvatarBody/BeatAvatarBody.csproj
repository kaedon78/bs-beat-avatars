<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BeatAvatarBody</AssemblyName>
    <RootNamespace>BeatAvatarBody</RootNamespace>
  </PropertyGroup>

  <!--
    All references resolve out of a Beat Saber install (see Directory.Build.props); nothing here
    is redistributable and none of it is committed. Private=false throughout: these assemblies
    are supplied by the game at runtime and must not be copied next to the plugin.

    Three directories, not one. BSIPA leaves IPA.Loader.dll in Managed\ beside the game's own
    assemblies; the third-party libraries live in Libs\; and BSML is a mod, so it is in Plugins\.
  -->
  <ItemGroup>
    <!-- BSIPA discovers plugin metadata from an embedded resource ending in manifest.json. -->
    <EmbeddedResource Include="manifest.json" />
    <!-- Logical name must match [ViewDefinition]: BeatAvatarBody.UI.Views.Settings.bsml -->
    <EmbeddedResource Include="UI\Views\Settings.bsml" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="IPA.Loader">
      <HintPath>$(GameRefDir)IPA.Loader.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The avatar system itself. AvatarCore has the interfaces and Avatar; the adapter has
         BeatAvatarSystem and the AvatarData converter; the SDK has AvatarData and the
         pose/visual controllers we reflect over to classify head parts. -->
    <Reference Include="BeatSaber.AvatarCore">
      <HintPath>$(GameRefDir)BeatSaber.AvatarCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatSaber.BeatAvatarAdapter">
      <HintPath>$(GameRefDir)BeatSaber.BeatAvatarAdapter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatSaber.BeatAvatarSDK">
      <HintPath>$(GameRefDir)BeatSaber.BeatAvatarSDK.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- MultiplayerAvatarData / MultiplayerAvatarsData / BitMask128. -->
    <Reference Include="GameplayCore">
      <HintPath>$(GameRefDir)GameplayCore.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- VRController, for the hand poses. -->
    <Reference Include="HMLib">
      <HintPath>$(GameRefDir)HMLib.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- VRCenterAdjust: the player-space transform the avatar is parented under. -->
    <Reference Include="Main">
      <HintPath>$(GameRefDir)Main.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- MirrorRendererSO._reflectLayers is the lever for showing the avatar in mirrors. -->
    <Reference Include="Rendering">
      <HintPath>$(GameRefDir)Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- PersistentScriptableObject, the base of MirrorRendererSO. -->
    <Reference Include="BGLib.UnityExtension">
      <HintPath>$(GameRefDir)BGLib.UnityExtension.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Reading UserData\BeatAvatarBody.json. -->
    <!-- The tuning panel: BSML for the view, HMUI for FlowCoordinator/ViewController. -->
    <Reference Include="BSML">
      <HintPath>$(GamePluginsDir)BSML.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HMUI.FlowCoordinator and HMUI.ViewController live here, not in HMUI.dll. -->
    <Reference Include="BeatSaber.ViewSystem">
      <HintPath>$(GameRefDir)BeatSaber.ViewSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(GameRefDir)HMUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BGLib.Polyglot">
      <HintPath>$(GameRefDir)BGLib.Polyglot.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRUI">
      <HintPath>$(GameRefDir)VRUI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameRefDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UniversalRendererData.opaqueLayerMask: URP filters layers a second time, after the
         camera's culling mask. -->
    <Reference Include="Unity.RenderPipelines.Universal.Runtime">
      <HintPath>$(GameRefDir)Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <HintPath>$(GameRefDir)Unity.RenderPipelines.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Zenject">
      <HintPath>$(GameRefDir)Zenject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <HintPath>$(GameRefDir)Zenject-usage.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(GameRefDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRefDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(GameRefDir)UnityEngine.XRModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.VRModule">
      <HintPath>$(GameRefDir)UnityEngine.VRModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
